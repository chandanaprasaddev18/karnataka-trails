# Copy to .env and adjust.  `make up` reads this file for the host port mapping.
#
# NOTE ON PORTS: the defaults here deliberately avoid 5432/11434 because this
# machine already runs legalrag-db on 5433. Nothing here can collide with it.

# --- Postgres (consumed by docker compose) ----------------------------------
POSTGRES_USER=tripplan
POSTGRES_PASSWORD=tripplan_dev_only
POSTGRES_DB=tripplan
POSTGRES_HOST_PORT=5434

# --- Postgres (consumed by the app; host/port as seen FROM THE HOST) --------
TRIPPLAN_DB__HOST=localhost
TRIPPLAN_DB__PORT=5434
TRIPPLAN_DB__USER=tripplan
TRIPPLAN_DB__PASSWORD=tripplan_dev_only
TRIPPLAN_DB__DATABASE=tripplan

# --- Retrieval (stage 1 candidate caps) -------------------------------------
# Caps keep the prompt small and the model's choice space tractable.
TRIPPLAN_RETRIEVAL__MAX_PLACES=30
TRIPPLAN_RETRIEVAL__MAX_STAYS=12
TRIPPLAN_RETRIEVAL__MAX_ACTIVITIES=20

# --- Routing (stage 4) ------------------------------------------------------
# osrm   = real road network via OSRM (open source, no key, free)
# static = straight-line km x road factor at a flat speed (the placeholder)
#
# The static values below still matter under osrm: they are the fallback for any
# pair OSRM cannot answer, and such legs stay labelled 'static_haversine' so a
# partly-degraded plan says which numbers were guessed.
TRIPPLAN_ROUTING__PROVIDER=osrm
TRIPPLAN_ROUTING__OSRM_BASE_URL=https://router.project-osrm.org
TRIPPLAN_ROUTING__OSRM_TIMEOUT_SECONDS=20
TRIPPLAN_ROUTING__ROAD_FACTOR=1.35
TRIPPLAN_ROUTING__AVG_SPEED_KMH=28
TRIPPLAN_ROUTING__MAX_TRAVEL_MINUTES_PER_DAY=300

# --- Itinerary shape --------------------------------------------------------
TRIPPLAN_PLANNING__DAY_ACTIVITY_MINUTES=480
TRIPPLAN_PLANNING__DAY_START_TIME=09:00

# --- LLM composition (step 6) -----------------------------------------------
# none      = deterministic composer only (steps 1-5; no network, no keys)
# hosted    = OpenAI-compatible free-tier endpoint (Groq / Google AI Studio)
# ollama    = local model via the `llm` compose profile
# claude    = Anthropic API (paid; no free tier)
TRIPPLAN_LLM__BACKEND=none
TRIPPLAN_LLM__MODEL=
TRIPPLAN_LLM__BASE_URL=
TRIPPLAN_LLM__TIMEOUT_SECONDS=90
TRIPPLAN_LLM__MAX_REPAIR_ATTEMPTS=1

# Leave blank unless you actually have these. Nothing here is required for
# steps 1-5, and an unset key makes the engine use the deterministic composer
# rather than failing.
TRIPPLAN_LLM__API_KEY=
OLLAMA_HOST_PORT=11436

# --- Photographs ------------------------------------------------------------
# `make fetch-photos` downloads Creative Commons images from Wikimedia Commons
# into this directory and the app serves them from PUBLIC_PREFIX. They are
# downloaded rather than hotlinked because Commons rate-limits (429) and a page
# load should not depend on a free external service.
TRIPPLAN_PHOTOS__DIR=web/public/photos
TRIPPLAN_PHOTOS__PUBLIC_PREFIX=/photos
TRIPPLAN_PHOTOS__WIDTH=1280

# --- Observability ----------------------------------------------------------
TRIPPLAN_LOG_LEVEL=INFO
TRIPPLAN_LOG_JSON=false

# --- Worker -----------------------------------------------------------------
TRIPPLAN_WORKER__POLL_INTERVAL_SECONDS=2
TRIPPLAN_WORKER__LOCK_TIMEOUT_SECONDS=300
