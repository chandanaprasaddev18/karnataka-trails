# Production frontend config (Vercel: set these as Environment Variables).
#
# The API's public URL. Server components and the browser both call it, so it must
# be reachable from the internet, not localhost.
NEXT_PUBLIC_API_BASE=https://YOUR-API.onrender.com

# `remote` serves photographs from Wikimedia's CDN instead of web/public/photos,
# which is gitignored (73 MB) and therefore absent from a deployed build.
NEXT_PUBLIC_PHOTO_SOURCE=remote
